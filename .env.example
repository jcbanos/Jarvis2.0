# Copy this file to .env and fill in the values. Never commit .env.

# Your key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Which Claude model the agent uses
JARVIS_MODEL=claude-sonnet-5-5

# Your private ntfy topic. Use a long random name: anyone who knows it can read
# your answers. Generate one with:
#   python3 -c "import secrets; print('jarvis-' + secrets.token_hex(10))"
NTFY_TOPIC=

# Shared with the Pebble app, which signs each request with it. Enter the same
# value in the app's webhook signing settings. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# --- Ideas by voice (see "Ideas by voice" in the README) ---

# A fine-grained GitHub token limited to this repo, with "Issues: Read and
# write" only. The README shows how to create one.
GITHUB_TOKEN=

# The repo your ideas become issues in, as owner/name.
GITHUB_REPO=jcbanos/Jarvis2.0

# This Pi's public address, the same as in the Pebble app's webhook URL but
# without /webhook, e.g. https://jarvis.<tailnet>.ts.net
# The "Create issue" button on your phone calls it.
JARVIS_PUBLIC_URL=

# --- Flashcards by voice (see "Flashcards by voice" in the README) ---

# Printed by scripts/anki_login.py. Works like a password for your AnkiWeb
# account. Leave blank to only change the local copy, without syncing.
ANKI_SYNC_KEY=
# Only if scripts/anki_login.py or the log names one. Usually blank.
ANKI_SYNC_ENDPOINT=

# The deck new cards go into. Created if it doesn't exist.
ANKI_DECK=German-Jarvis

# Where the Pi's copy of your collection lives. Blank means anki/collection.anki2.
ANKI_COLLECTION=
