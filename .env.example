# Copy this file to .env and fill in the values. Never commit .env.

# Your key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Which Claude model the agent uses
JARVIS_MODEL=claude-sonnet-5-5

# Your private ntfy topic. Use a long random name: anyone who knows it can read
# your answers. Generate one with:
#   python3 -c "import secrets; print('jarvis-' + secrets.token_hex(10))"
NTFY_TOPIC=

# Shared with the Pebble app, which signs each request with it. Enter the same
# value in the app's webhook signing settings. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
