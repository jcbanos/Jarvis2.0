# Secrets: never commit these
.env

# Rebuilt on each machine
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# Local record of webhook deliveries already handled
*.sqlite3

# The Pi's copy of your Anki collection (scripts/anki_login.py)
anki/

# On the Pi: the automatic deploy's memory of a failed commit, and its lock
.deploy-state
.deploy.lock
# On the Pi: old venvs kept as a backup, like .venv-3.13
.venv-*/
